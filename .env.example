LLM_PROVIDER=groq              # groq | gemini (the other is used as fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b       # fastest on Groq (~0.2s); alt: openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b  # last resort if Groq and Gemini are both busy
SECRET_KEY=change-me-to-any-random-string
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=1234
LLM_TIMEOUT=12                 # seconds per model before trying the next
TZ_OFFSET_MINUTES=330            # timezone for dates the agents use (330 = India, UTC+5:30)
